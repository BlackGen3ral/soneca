<Window x:Class="Soneca.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Soneca"
        Title="Artho AI" Icon="Assets/ArthoAI.ico" Width="990" Height="710" MinWidth="760" MinHeight="590"
        Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Grid Background="{StaticResource Backdrop}">
        <Rectangle Fill="{StaticResource BackdropLight}" IsHitTestVisible="False"/>
        <Rectangle Fill="{StaticResource BackdropTint}" IsHitTestVisible="False"/>
        <Grid x:Name="DashboardContent">
            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource GlassEdge}" BorderThickness="1"
                    CornerRadius="15" Padding="12,15,12,13" Margin="12,12,0,12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="5,0,0,19">
                            <Image Source="Assets/ArthoAI.png" Width="30" Height="30"/>
                            <TextBlock Text="Artho AI" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <RadioButton x:Name="HomeNav" Style="{StaticResource Navigation}" GroupName="Pages" Content="Início" Tag="&#xE80F;" Click="Home_Click" IsChecked="True"/>
                        <RadioButton x:Name="HouseNav" Style="{StaticResource Navigation}" GroupName="Pages" Content="Minha casa" Tag="&#xEC06;" Click="House_Click"/>
                        <RadioButton x:Name="DevicesNav" Style="{StaticResource Navigation}" GroupName="Pages" Content="Dispositivos" Tag="&#xE7F4;" Click="Devices_Click"/>
                        <RadioButton x:Name="MobileNav" Style="{StaticResource Navigation}" GroupName="Pages" Content="Celular" Tag="&#xE8EA;" Click="Mobile_Click"/>
                        <Border Style="{StaticResource Divider}" Margin="8,8,8,8"/>
                        <RadioButton x:Name="EnergyNav" Style="{StaticResource Navigation}" GroupName="Pages" Content="Energia" Tag="&#xE7E8;" Click="Energy_Click"/>
                        <RadioButton x:Name="CleanupNav" Style="{StaticResource Navigation}" GroupName="Pages" Content="Limpeza" Tag="&#xE74D;" Click="Cleanup_Click"/>
                        <RadioButton x:Name="NamesNav" Style="{StaticResource Navigation}" GroupName="Pages" Content="Nomes da pasta" Tag="&#xE8B7;" Click="Names_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2">
                        <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,14"/>
                        <RadioButton x:Name="UpdatesNav" Style="{StaticResource Navigation}" GroupName="Pages" Content="Atualizações" Tag="&#xE895;" Click="UpdatesNav_Click"/>
                        <RadioButton x:Name="SettingsNav" Style="{StaticResource Navigation}" GroupName="Pages" Content="Preferências" Tag="&#xE713;" Click="Settings_Click"/>
                        <TextBlock x:Name="VersionLabel" Foreground="{StaticResource Muted}" FontSize="12" Margin="11,9,4,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer x:Name="HomePanel" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="960" Margin="32,29,32,28">
                    <Border Style="{StaticResource Panel}" Background="{StaticResource GlassHero}" Padding="23,17">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Este computador" Style="{StaticResource BodyCopy}"/>
                                <TextBlock x:Name="ComputerNameLabel" FontSize="31" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,4,0,3"/>
                                <TextBlock x:Name="ComputerDetailsLabel" Style="{StaticResource BodyCopy}"/>
                            </StackPanel>
                            <Border Grid.Column="1" CornerRadius="18" Background="#71335062" BorderBrush="#675F99A4"
                                    BorderThickness="1" Padding="13,7" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="NetworkStatusLabel" Foreground="{StaticResource Accent}" FontSize="12"/>
                            </Border>
                        </Grid>
                    </Border>
                    <Border x:Name="HomeUpdateBanner" Style="{StaticResource Panel}" Visibility="Collapsed" Margin="0,17,0,0" Padding="12">
                        <DockPanel>
                            <Button Content="Ver atualização" DockPanel.Dock="Right" Click="UpdatesNav_Click" Margin="12,0,0,0"/>
                            <TextBlock x:Name="HomeUpdateText" Foreground="{StaticResource Accent}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>
                    <Grid Margin="0,27,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Estado do PC" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                            <Border Style="{StaticResource Panel}" Padding="13,0">
                                <StackPanel>
                                    <StackPanel Margin="0,13,0,12">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                                <TextBlock x:Name="MemoryValue" Style="{StaticResource InfoValue}"/>
                                                <TextBlock x:Name="MemoryTotal" Style="{StaticResource BodyCopy}" Margin="5,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="Memória em uso" Style="{StaticResource BodyCopy}"/>
                                        </DockPanel>
                                        <ProgressBar x:Name="MemoryGauge" Minimum="0" Maximum="100" Height="4" Margin="0,8,0,0"
                                                     Foreground="{StaticResource Accent}" Background="{StaticResource Line}" AutomationProperties.Name="Percentual de memória em uso"/>
                                    </StackPanel>
                                    <Border Style="{StaticResource Divider}"/>
                                    <DockPanel Margin="0,12">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                            <TextBlock x:Name="ProcessorValue" Style="{StaticResource InfoValue}"/>
                                            <TextBlock Text="lógicos" Style="{StaticResource BodyCopy}" Margin="5,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="Processador" Style="{StaticResource BodyCopy}"/>
                                    </DockPanel>
                                    <Border Style="{StaticResource Divider}"/>
                                    <DockPanel Margin="0,12">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                            <TextBlock x:Name="UptimeValue" Style="{StaticResource InfoValue}"/>
                                        </StackPanel>
                                        <TextBlock Text="Tempo ligado" Style="{StaticResource BodyCopy}"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Acesso rápido" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                            <Border Style="{StaticResource Panel}" Padding="1">
                                <StackPanel>
                                    <Button Style="{StaticResource ActionRow}" Tag="&#xE7E8;" Click="Energy_Click" AutomationProperties.Name="Programar desligamento">
                                        <StackPanel>
                                            <TextBlock Text="Programar desligamento" Style="{StaticResource InfoValue}"/>
                                            <TextBlock x:Name="HomeEnergySubtitle" Style="{StaticResource BodyCopy}"/>
                                        </StackPanel>
                                    </Button>
                                    <Border Style="{StaticResource Divider}" Margin="12,0"/>
                                    <Button Style="{StaticResource ActionRow}" Tag="&#xE7F4;" Click="Devices_Click" AutomationProperties.Name="Computadores pareados">
                                        <StackPanel>
                                            <TextBlock Text="Computadores pareados" Style="{StaticResource InfoValue}"/>
                                            <TextBlock Text="Ver estado e editar horários" Style="{StaticResource BodyCopy}"/>
                                        </StackPanel>
                                    </Button>
                                    <Border Style="{StaticResource Divider}" Margin="12,0"/>
                                    <Button Style="{StaticResource ActionRow}" Tag="&#xE8EA;" Click="Mobile_Click" AutomationProperties.Name="Conectar celular">
                                        <StackPanel>
                                            <TextBlock Text="Conectar celular" Style="{StaticResource InfoValue}"/>
                                            <TextBlock Text="Parear por QR Code" Style="{StaticResource BodyCopy}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>


            <Border x:Name="HousePage" Grid.Column="1" Margin="16,12,12,12" Visibility="Collapsed"
                    Style="{StaticResource Panel}" Padding="0">
                <Grid>
                    <StackPanel x:Name="HouseLock" Width="325" Margin="20" VerticalAlignment="Center">
                        <TextBlock Text="Minha casa" Style="{StaticResource SectionTitle}" FontSize="24" Margin="0,0,0,12"/>
                        <TextBlock x:Name="HouseFeedback" Style="{StaticResource BodyCopy}" TextWrapping="Wrap"
                                   Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite"/>
                        <PasswordBox x:Name="HousePassword" MaxLength="128" MinHeight="36" Padding="8"
                                     AutomationProperties.Name="Senha da maquete" KeyDown="HousePassword_KeyDown"/>
                        <Button x:Name="HouseUnlock" HorizontalAlignment="Left" Margin="0,10,0,0"
                                Content="Abrir maquete" Click="HouseUnlock_Click"/>
                    </StackPanel>
                    <ContentControl x:Name="HouseSurface" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                </Grid>
            </Border>
            <ScrollViewer x:Name="DevicesPanel" Grid.Column="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30,25,30,25" MaxWidth="1080">
                    <DockPanel Margin="0,0,0,12">
                        <Button Content="Atualizar status" DockPanel.Dock="Right" Click="DevicesRefresh_Click" Margin="12,0,0,0"/>
                        <TextBlock Text="Dispositivos" Style="{StaticResource PageTitle}"/>
                    </DockPanel>
                    <TextBlock Text="Controle até três PCs na mesma rede. Os horários seguem o relógio deste computador de controle."
                               Style="{StaticResource BodyCopy}" Margin="0,0,0,12"/>
                    <TextBlock x:Name="DeviceNotice" Style="{StaticResource BodyCopy}" AutomationProperties.LiveSetting="Polite"
                               Margin="0,0,0,10" Visibility="Collapsed"/>
                    <Border x:Name="DeviceList" Style="{StaticResource Panel}" Padding="0" Visibility="Collapsed">
                        <StackPanel x:Name="DeviceCards"/>
                    </Border>
                    <Border Style="{StaticResource Panel}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Adicionar outro PC" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="No outro PC, permita o controle e gere um código nesta mesma aba. Cole o código aqui."
                                       Style="{StaticResource BodyCopy}" Margin="0,7,0,10"/>
                            <TextBox x:Name="DeviceInviteInput" MaxLength="600" AutomationProperties.Name="Código do outro PC"/>
                            <Button x:Name="DevicePair" Content="Parear PC" Style="{StaticResource Primary}" Click="DevicesPair_Click"
                                    HorizontalAlignment="Left" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Permitir controle deste PC" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Um PC autorizado poderá consultar o estado e solicitar desligamento. Mantenha o Artho AI aberto neste PC para receber comandos."
                                       Style="{StaticResource BodyCopy}" Margin="0,7,0,10"/>
                            <ComboBox x:Name="PcAgentNetwork" DisplayMemberPath="Address" AutomationProperties.Name="Endereço deste PC na rede local"
                                      MinWidth="185" MinHeight="32" HorizontalAlignment="Left" Foreground="#102030" Background="#EDF7FF"/>
                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="PcAgentCode" Content="Gerar e copiar código" Click="PcAgentCode_Click" Margin="0,0,8,0"/>
                                <Button x:Name="PcAgentOff" Content="Desativar controle" Click="PcAgentOff_Click"/>
                            </WrapPanel>
                            <TextBlock x:Name="PcAgentNotice" Style="{StaticResource BodyCopy}" Text="Controle desativado." Margin="0,10,0,0"
                                       AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="MobilePanel" Grid.Column="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30,25,30,25" MaxWidth="920">
                    <TextBlock Text="Celular" Style="{StaticResource PageTitle}"/>
                    <UniformGrid Columns="2" Margin="0,14,0,16" HorizontalAlignment="Left">
                        <RadioButton x:Name="AndroidMode" GroupName="MobileDirection" Content="Controlar Android" Tag="&#xE8EA;"
                                     Style="{StaticResource Navigation}" Margin="0,0,8,0" Padding="12,5" IsChecked="True" Click="MobileDirection_Click"/>
                        <RadioButton x:Name="PcMobileMode" GroupName="MobileDirection" Content="Controlar PC" Tag="&#xE7F4;"
                                     Style="{StaticResource Navigation}" Margin="0" Padding="12,5" Click="MobileDirection_Click"/>
                    </UniformGrid>
                    <StackPanel x:Name="AndroidModePanel">
                        <Border Style="{StaticResource Panel}" Background="{StaticResource GlassHero}" Padding="22">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Width="48" Height="48" CornerRadius="12" Background="#365D879F" BorderBrush="{StaticResource GlassEdge}"
                                            BorderThickness="1" VerticalAlignment="Top">
                                        <TextBlock Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource Accent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                        <TextBlock Text="Espelhar o Android" Style="{StaticResource SectionTitle}" FontSize="23"/>
                                        <TextBlock Text="Use o mouse e o teclado para controlar o celular dentro do Artho AI."
                                                   Style="{StaticResource BodyCopy}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <WrapPanel Margin="0,16,0,0">
                                    <Button x:Name="AndroidRemembered" Content="Abrir Android pareado" Style="{StaticResource Primary}"
                                            Click="AndroidRemembered_Click" Margin="0,0,8,6"/>
                                    <Button x:Name="AndroidPairQr" Content="Parear com QR Code" Click="AndroidQr_Click" Margin="0,0,8,6"/>
                                    <Button x:Name="AndroidResume" Content="Mostrar tela" Style="{StaticResource Primary}" Click="AndroidResume_Click"
                                            Visibility="Collapsed" Margin="0,0,8,6"/>
                                    <Button x:Name="AndroidStop" Content="Encerrar controle" IsEnabled="False" Visibility="Collapsed"
                                            Click="AndroidStop_Click" Margin="0,0,0,6"/>
                                </WrapPanel>
                                <TextBlock x:Name="AndroidStatus" Text="Para parear por Wi-Fi, ative a Depuração sem fio no Android e use a mesma rede do PC."
                                           Style="{StaticResource BodyCopy}" Margin="0,7,0,0" AutomationProperties.LiveSetting="Polite"/>
                                <StackPanel x:Name="AndroidQrPanel" Visibility="Collapsed" Margin="0,14,0,0">
                                    <TextBlock Text="Na Depuração sem fio do Android, toque em Parear dispositivo com código QR. O código vale por dois minutos."
                                               Style="{StaticResource BodyCopy}"/>
                                    <Image x:Name="AndroidQrImage" Width="216" Height="216" HorizontalAlignment="Left" Margin="0,9,0,0"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="QR Code para o pareamento sem fio do Android"/>
                                    <Button Content="Cancelar QR Code" Click="AndroidStop_Click" HorizontalAlignment="Left" Margin="0,9,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Panel}" Margin="0,12,0,0" Padding="20,14">
                            <Expander x:Name="AndroidWifiOptions" Header="USB e conexão manual">
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="Para usar um cabo de dados, ative a Depuração USB no Android e aceite a autorização no celular."
                                               Style="{StaticResource BodyCopy}"/>
                                    <Button x:Name="AndroidUsb" Content="Abrir por USB" Click="AndroidUsb_Click" HorizontalAlignment="Left" Margin="0,8,0,2"/>
                                    <Expander x:Name="AndroidManual" Header="Conectar com endereço e porta" Margin="0,10,0,0">
                                        <StackPanel Margin="0,7,0,0">
                                            <TextBlock x:Name="AndroidConnectLabel" Text="Endereço e porta da tela principal de Depuração sem fio"
                                                       Style="{StaticResource BodyCopy}" Margin="0,0,0,3"/>
                                            <TextBox x:Name="AndroidConnectAddress" MaxLength="21" MinWidth="160" HorizontalAlignment="Left"
                                                     AutomationProperties.LabeledBy="{Binding ElementName=AndroidConnectLabel}"/>
                                            <Button x:Name="AndroidWifi" Content="Abrir por Wi-Fi" Click="AndroidWifi_Click" HorizontalAlignment="Left" Margin="0,7,0,0"/>
                                            <Expander x:Name="AndroidPairHelp" Header="Parear com código de seis dígitos" Margin="0,10,0,0">
                                                <StackPanel Margin="0,7,0,0">
                                                    <TextBlock Text="Abra o código de pareamento no celular e informe o endereço e o código dessa tela."
                                                               Style="{StaticResource BodyCopy}" Margin="0,0,0,6"/>
                                                    <TextBlock x:Name="AndroidPairLabel" Text="Endereço e porta de pareamento" Style="{StaticResource BodyCopy}"/>
                                                    <TextBox x:Name="AndroidPairAddress" MaxLength="21" MinWidth="160" HorizontalAlignment="Left"
                                                             AutomationProperties.LabeledBy="{Binding ElementName=AndroidPairLabel}"/>
                                                    <TextBlock x:Name="AndroidCodeLabel" Text="Código de seis dígitos" Style="{StaticResource BodyCopy}" Margin="0,7,0,0"/>
                                                    <PasswordBox x:Name="AndroidPairCode" MaxLength="6" MinWidth="120" MinHeight="29" HorizontalAlignment="Left"
                                                                 AutomationProperties.LabeledBy="{Binding ElementName=AndroidCodeLabel}"/>
                                                    <Button x:Name="AndroidPair" Content="Parear Android" Click="AndroidPair_Click" HorizontalAlignment="Left" Margin="0,7,0,0"/>
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Expander>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="PcMobileModePanel" Visibility="Collapsed">
                        <Border Style="{StaticResource Panel}" Padding="22">
                            <StackPanel>
                            <TextBlock Text="Controlar PC pelo Android" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Pareie pelo QR Code para ver a tela do PC e usar os controles liberados na rede local."
                                       Style="{StaticResource BodyCopy}" Margin="0,6,0,0"/>
                            <TextBlock x:Name="MobileNetworkLabel" Text="Endereço do PC na rede do celular" Style="{StaticResource BodyCopy}" Margin="0,13,0,5"/>
                            <ComboBox x:Name="MobileNetwork" HorizontalAlignment="Left" MinWidth="190" MinHeight="32"
                                      AutomationProperties.LabeledBy="{Binding ElementName=MobileNetworkLabel}"
                                      AutomationProperties.Name="Endereço do PC na rede do celular" Foreground="#102030" Background="#EDF7FF">
                                <ComboBox.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#102030"/>
                                    </Style>
                                </ComboBox.Resources>
                            </ComboBox>
                            <CheckBox x:Name="MobileAllowDevices" Content="Permitir que o celular ligue os PCs e edite os horários"
                                      Margin="0,12,0,0"/>
                            <CheckBox x:Name="MobileAllowPower" Content="Permitir que o celular desligue, reinicie e programe este PC"/>
                            <Button x:Name="MobileStart" Content="Gerar QR Code" Style="{StaticResource Primary}"
                                    HorizontalAlignment="Left" Margin="0,13,0,0" Click="MobileStart_Click"/>
                            <TextBlock x:Name="MobileStatus" Style="{StaticResource BodyCopy}" Margin="0,12,0,0"
                                       Text="Nenhuma sessão de pareamento aberta." AutomationProperties.LiveSetting="Polite"/>
                            <Image x:Name="MobileQr" Visibility="Collapsed" HorizontalAlignment="Left" Width="246" Height="246"
                                   Margin="0,13,0,0" RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   AutomationProperties.Name="QR Code de pareamento com o celular"/>
                            <Button x:Name="MobileStop" Content="Encerrar conexão" Visibility="Collapsed"
                                    HorizontalAlignment="Left" Margin="0,13,0,0" Click="MobileStop_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}" Padding="22" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Tela remota do PC" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="RemoteDesktopStatus" Text="Acesso à tela desativado." Style="{StaticResource BodyCopy}"
                                       Margin="0,7,0,0" AutomationProperties.LiveSetting="Polite"/>
                            <Button x:Name="RemoteDesktopButton" Content="Liberar acesso à tela" Click="RemoteDesktop_Click"
                                    IsEnabled="False" HorizontalAlignment="Left" Margin="0,11,0,0"/>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="AndroidViewerPanel" Grid.Column="1" Visibility="Collapsed" Margin="26,22,26,22">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,10">
                    <Button Content="Encerrar controle" Click="AndroidStop_Click" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                    <Button Content="Voltar" Click="AndroidBack_Click" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                    <TextBlock Text="Tela do Android" Style="{StaticResource PageTitle}" FontSize="26" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock x:Name="AndroidViewerStatus" Grid.Row="1" Text="{Binding ElementName=AndroidStatus, Path=Text}"
                           Style="{StaticResource BodyCopy}" Margin="1,0,0,11" AutomationProperties.LiveSetting="Polite"/>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="164"/></Grid.ColumnDefinitions>
                    <Border Background="#A0101B2D" BorderBrush="{StaticResource GlassEdge}" BorderThickness="1" CornerRadius="14" Margin="0,0,12,0">
                        <Grid x:Name="AndroidStage" SizeChanged="AndroidStage_SizeChanged">
                            <StackPanel x:Name="AndroidWaitingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Margin="20">
                                <TextBlock Text="Aguardando o celular" Style="{StaticResource SectionTitle}" TextAlignment="Center"/>
                                <TextBlock Text="Por Wi-Fi, mantenha a Depuração por Wi-Fi ativa no Android e os dois aparelhos na mesma rede."
                                           Style="{StaticResource BodyCopy}" TextAlignment="Center" Margin="0,8,0,12"/>
                                <Button Content="Conectar com IP e porta" Click="AndroidManualFromViewer_Click" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <Border x:Name="AndroidPhoneFrame" Visibility="Collapsed" Width="220" Height="450"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="18"
                                    Background="#FF121923" BorderThickness="2" BorderBrush="#FF657D96">
                                <Grid Margin="8,0">
                                    <Grid.RowDefinitions><RowDefinition Height="14"/><RowDefinition Height="*"/><RowDefinition Height="14"/></Grid.RowDefinitions>
                                    <Border Height="3" Width="34" Background="#FF48576A" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border Grid.Row="1" Background="#FF080B12">
                                        <ContentControl x:Name="AndroidSurface" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                                    </Border>
                                    <Border Grid.Row="2" Height="3" Width="24" Background="#FF303D4D" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Panel}" Padding="13" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Tela" Style="{StaticResource SectionTitle}"/>
                            <Button x:Name="AndroidWake" Content="Acender tela" Click="AndroidWake_Click" IsEnabled="False" Margin="0,9,0,6"/>
                            <Button x:Name="AndroidSleep" Content="Desligar tela" Click="AndroidSleep_Click" IsEnabled="False"/>
                            <Border Style="{StaticResource Divider}" Margin="0,14,0,12"/>
                            <TextBlock Text="Energia" Style="{StaticResource SectionTitle}"/>
                            <Button x:Name="AndroidReboot" Content="Reiniciar celular" Click="AndroidReboot_Click" IsEnabled="False" Margin="0,9,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <ScrollViewer x:Name="EnergyPanel" Grid.Column="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30,25,30,25" MaxWidth="1080">
                    <TextBlock Text="Energia" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Agende quando este PC deve desligar." Style="{StaticResource BodyCopy}" Margin="0,5,0,18"/>
                    <Border Style="{StaticResource Panel}" Padding="17,13">
                        <StackPanel>
                            <TextBlock x:Name="StatusLabel" Style="{StaticResource BodyCopy}"/>
                            <TextBlock x:Name="CountdownLabel" FontFamily="Cascadia Mono, Consolas" FontSize="37" FontWeight="SemiBold" Margin="0,5,0,3"/>
                            <TextBlock x:Name="TargetLabel" Style="{StaticResource BodyCopy}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}" Margin="0,13,0,0">
                        <StackPanel>
                            <TextBlock Text="Quando desligar" Style="{StaticResource SectionTitle}" Margin="0,0,0,11"/>
                            <UniformGrid Columns="2">
                                <RadioButton x:Name="DelayMode" Style="{StaticResource Navigation}" Content="Daqui a um tempo" Tag="&#xE823;" GroupName="TimeMode" Click="Delay_Click" IsChecked="True" Margin="0,0,5,0"/>
                                <RadioButton x:Name="ClockMode" Style="{StaticResource Navigation}" Content="Em um horário" Tag="&#xE121;" GroupName="TimeMode" Click="Clock_Click" Margin="5,0,0,0"/>
                            </UniformGrid>
                            <UniformGrid x:Name="Presets" Columns="4" Margin="0,11,0,0">
                                <Button Content="15 min" Tag="15" Click="Preset_Click" Margin="0,0,6,0"/>
                                <Button Content="30 min" Tag="30" Click="Preset_Click" Margin="0,0,6,0"/>
                                <Button Content="1 hora" Tag="60" Click="Preset_Click" Margin="0,0,6,0"/>
                                <Button Content="2 horas" Tag="120" Click="Preset_Click"/>
                            </UniformGrid>
                            <TextBlock x:Name="InputLabel" Text="Tempo personalizado (minutos)" Style="{StaticResource BodyCopy}" Margin="0,13,0,6"/>
                            <TextBox x:Name="TimeInput" Text="30" TextChanged="Input_Changed" MaxLength="5" AutomationProperties.LabeledBy="{Binding ElementName=InputLabel}"/>
                            <TextBlock x:Name="ErrorLabel" Foreground="{StaticResource Warning}" TextWrapping="Wrap" Margin="0,6" AutomationProperties.LiveSetting="Polite"/>
                            <Button x:Name="ScheduleButton" Content="Agendar desligamento" Style="{StaticResource Primary}" Click="Schedule_Click"/>
                            <Button x:Name="CancelButton" Content="Cancelar desligamento" Click="Cancel_Click" Visibility="Collapsed" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Pode fechar o app após agendar. Mantenha a sessão conectada e salve seus arquivos. Apps abertos podem impedir o desligamento. O despertar da suspensão depende das configurações do Windows." Style="{StaticResource BodyCopy}" FontSize="12" Margin="0,13,0,0"/>
                </StackPanel>
            </ScrollViewer>
            <local:CleanupView x:Name="CleanupPanel" Grid.Column="1" Visibility="Collapsed"/>
            <local:FolderNamesView x:Name="NamesPanel" Grid.Column="1" Visibility="Collapsed"/>
            <ScrollViewer x:Name="SettingsPanel" Grid.Column="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30,25,30,25" MaxWidth="1080">
                    <TextBlock Text="Preferências" Style="{StaticResource PageTitle}"/>
                    <Border Style="{StaticResource Panel}" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="Inicialização" Style="{StaticResource SectionTitle}"/>
                            <CheckBox x:Name="StartupCheckBox" Content="Iniciar o Artho AI com o Windows" Checked="Startup_Changed" Unchecked="Startup_Changed" Margin="0,11,0,0"/>
                            <TextBlock Text="Use Esc para pular a abertura a qualquer momento." Style="{StaticResource BodyCopy}" Margin="0,6,0,0"/>
                            <Button x:Name="ReplayIntroButton" Content="Rever abertura" Click="ReplayIntro_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                            <TextBlock x:Name="StartupFeedback" Style="{StaticResource BodyCopy}" Margin="0,7,0,0" AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="UpdatesPanel" Grid.Column="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="34,32,34,26" MaxWidth="1080">
                    <TextBlock Text="Atualizações" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="O Artho AI consulta o GitHub ao abrir. Você escolhe quando baixar e instalar." Style="{StaticResource BodyCopy}" Margin="0,6,0,19"/>
                    <Border Style="{StaticResource Panel}" Padding="22">
                        <StackPanel>
                            <TextBlock x:Name="InstalledVersionLabel" Style="{StaticResource BodyCopy}"/>
                            <TextBlock x:Name="UpdateHeading" Text="Verificar nova versão" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,4"/>
                            <TextBlock x:Name="UpdateLabel" Style="{StaticResource BodyCopy}" AutomationProperties.LiveSetting="Polite"/>
                            <ProgressBar x:Name="UpdateProgress" Height="8" Maximum="100" Margin="0,16,0,0" Visibility="Collapsed"
                                         Foreground="{StaticResource Accent}" Background="{StaticResource Line}" AutomationProperties.Name="Progresso da atualização"/>
                            <WrapPanel Margin="0,17,0,0">
                                <Button x:Name="UpdateButton" Content="Verificar atualizações" Style="{StaticResource Primary}" Click="Update_Click" Margin="0,0,8,4"/>
                                <Button x:Name="UpdateCancel" Content="Cancelar download" Click="UpdateCancel_Click" Visibility="Collapsed" Margin="0,0,8,4"/>
                                <Button x:Name="UpdateNotes" Content="Ver versão no GitHub" Click="UpdateNotes_Click" Visibility="Collapsed" Margin="0,0,8,4"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="UpdateCheckedAt" Style="{StaticResource BodyCopy}" Margin="0,12,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Grid x:Name="IntroOverlay" Background="#02050D" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid x:Name="IntroSurface">
                <TextBlock x:Name="IntroPlaceholder" Text="ARTHO AI" Foreground="#A8CCF2" FontSize="29" FontWeight="Light"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <ContentControl x:Name="IntroBrowser" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
            </Grid>
            <Button x:Name="SkipIntroButton" Grid.Row="1" Content="Pular abertura  ·  Esc" Click="SkipIntro_Click"
                    Background="#101C31" Foreground="#CAE7FF" HorizontalAlignment="Right" Margin="20,0,26,18" Padding="14,8"/>
        </Grid>
    </Grid>
</Window>
