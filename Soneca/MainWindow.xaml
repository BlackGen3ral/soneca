<Window x:Class="Soneca.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Soneca" Title="Artho Control" Width="1040" Height="860" MinWidth="920" MinHeight="700" Background="#14141C" WindowStartupLocation="CenterScreen" Foreground="White">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="#1A1923" Padding="20,28,20,24"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><TextBlock Text="ARTHO" Foreground="#C7B8FF" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="Control" FontSize="29" FontWeight="SemiBold" Margin="0,2,0,0"/><TextBlock Text="Seu Windows. Do seu jeito." FontSize="11" Foreground="#9997AA" Margin="0,8,0,32"/><Button x:Name="EnergyNav" Content="Energia" Click="Energy_Click" Background="#49405F" HorizontalContentAlignment="Left"/><Button x:Name="CleanupNav" Content="Limpeza" Click="Cleanup_Click" Background="Transparent" Margin="0,8,0,0"/><Button x:Name="NamesNav" Content="Nomes da pasta" Click="Names_Click" Background="Transparent" Margin="0,8,0,0"/></StackPanel>
   <StackPanel Grid.Row="2"><TextBlock Text="Ferramentas pessoais" Foreground="#777487" FontSize="11"/>  <StackPanel Margin="0,22,0,0" VerticalAlignment="Bottom"><Button x:Name="UpdateButton" Content="Verificar atualizações" Click="Update_Click" Background="Transparent" Foreground="#BDB0EB" Padding="5" FontSize="12"/><TextBlock x:Name="UpdateLabel" Text="Atualizações automáticas ativadas" Foreground="#777487" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></StackPanel></Grid></Border> <ScrollViewer x:Name="EnergyPanel" Grid.Column="1" VerticalScrollBarVisibility="Auto"><Grid Margin="32,26,32,24" MaxWidth="560"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><StackPanel Orientation="Horizontal"><Border Background="#C7B8FF" Width="40" Height="40" CornerRadius="13"><TextBlock Text="◔" Foreground="#211C34" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="12,0,0,0"><TextBlock Text="Energia" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Desligamento programado" Foreground="#9997AA" FontSize="11"/></StackPanel></StackPanel><TextBlock x:Name="VersionLabel" HorizontalAlignment="Right" Foreground="#9997AA" VerticalAlignment="Center"/></Grid>
  <StackPanel Grid.Row="1" Margin="0,30,0,24"><TextBlock Text="Pode deixar comigo." FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Escolha quando o seu Windows vai desligar." Foreground="#AAA7BC" Margin="0,8,0,0" FontSize="14"/></StackPanel>
  <Border Grid.Row="2" Background="#1E1E29" CornerRadius="24" Padding="24,22" BorderBrush="#30303D" BorderThickness="1"><StackPanel>
   <TextBlock x:Name="StatusLabel" Text="NENHUM DESLIGAMENTO AGENDADO" Foreground="#BDB0EB" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
   <TextBlock x:Name="CountdownLabel" Text="00:30:00" FontFamily="Cascadia Mono, Consolas" FontSize="55" FontWeight="Light" HorizontalAlignment="Center" Margin="0,12,0,6"/>
   <TextBlock x:Name="TargetLabel" Text="Um tempo para terminar o que você está fazendo." Foreground="#AAA7BC" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"/>
  </StackPanel></Border>
  <StackPanel Grid.Row="3" Margin="0,24,0,0">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="DelayMode" Content="Daqui a um tempo" Click="Delay_Click" Background="#49405F" Margin="0,0,5,0"/><Button x:Name="ClockMode" Grid.Column="1" Content="Em um horário" Click="Clock_Click" Margin="5,0,0,0"/></Grid>
   <UniformGrid x:Name="Presets" Columns="4" Margin="0,16,0,14"><Button Content="15 min" Tag="15" Click="Preset_Click" Margin="0,0,6,0" Padding="8,11"/><Button Content="30 min" Tag="30" Click="Preset_Click" Margin="2,0,4,0" Padding="8,11"/><Button Content="1 hora" Tag="60" Click="Preset_Click" Margin="4,0,2,0" Padding="8,11"/><Button Content="2 horas" Tag="120" Click="Preset_Click" Margin="6,0,0,0" Padding="8,11"/></UniformGrid>
   <TextBlock x:Name="InputLabel" Text="Tempo personalizado (minutos)" Foreground="#AAA7BC" FontSize="12" Margin="0,0,0,8"/>
   <TextBox x:Name="TimeInput" Text="30" TextChanged="Input_Changed" MaxLength="5" AutomationProperties.Name="Tempo ou horário"/>
   <TextBlock x:Name="ErrorLabel" Foreground="#FFB9B9" FontSize="12" Margin="0,8,0,8" TextWrapping="Wrap"/>
   <Button x:Name="ScheduleButton" Content="Agendar desligamento" Background="#C7B8FF" Foreground="#211C34" FontWeight="SemiBold" Padding="20,16" Click="Schedule_Click"/>
   <Button x:Name="CancelButton" Content="Cancelar desligamento" Margin="0,10,0,0" Click="Cancel_Click" Visibility="Collapsed"/>
   <TextBlock Text="Pode fechar o app após agendar. Mantenha sua sessão conectada. O despertar da suspensão depende das configurações do Windows. Salve seus arquivos; apps abertos podem impedir o desligamento." Foreground="#8E8B9F" FontSize="11" TextWrapping="Wrap" LineHeight="17" Margin="2,16,2,0"/>
  </StackPanel>

 </Grid></ScrollViewer>
<local:CleanupView x:Name="CleanupPanel" Grid.Column="1" Visibility="Collapsed"/><local:FolderNamesView x:Name="NamesPanel" Grid.Column="1" Visibility="Collapsed"/></Grid></Window>

