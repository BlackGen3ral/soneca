<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <Version>1.4.0</Version><ApplicationIcon>Assets\soneca.ico</ApplicationIcon>
    <AssemblyName>Soneca</AssemblyName><Product>Artho AI</Product><Title>Artho AI</Title><Company>Artho</Company><Description>Assistente pessoal e central de controle para Windows.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <EmbeddedResource Include="Boot\Intro.html" LogicalName="Artho.Boot.Intro.html" />
    <EmbeddedResource Include="Boot\Intro.wav" LogicalName="Artho.Boot.Intro.wav" />
  </ItemGroup>
</Project>
