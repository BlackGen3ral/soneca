<UserControl x:Class="Soneca.CleanupView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,25,30,25" MaxWidth="1080">
            <TextBlock Text="Limpeza" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Analise os arquivos e confira o espaço encontrado antes de limpar." Style="{StaticResource BodyCopy}" Margin="0,5,0,18"/>
            <Border Style="{StaticResource Panel}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="15,0,0,0">
                        <TextBlock Text="ESPAÇO ENCONTRADO" Style="{StaticResource Overline}"/>
                        <TextBlock x:Name="TotalLabel" Text="—" FontSize="38" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Análise do Windows" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="SummaryLabel" Text="Selecione as categorias abaixo." Style="{StaticResource BodyCopy}" Margin="0,6,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <TextBlock Text="O que analisar" Style="{StaticResource SectionTitle}" Margin="0,18,0,9"/>
            <Border Style="{StaticResource Panel}" Padding="17,11">
                <StackPanel>
                    <CheckBox x:Name="TempCheck" Content="Arquivos temporários · %temp%" IsChecked="True" Click="Selection_Changed"/>
                    <TextBlock Text="Arquivos temporários do seu usuário. Itens em uso são ignorados." Style="{StaticResource BodyCopy}" Margin="18,2,0,0"/>
                    <TextBlock x:Name="TempLabel" Text="Aguardando análise" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="18,4,0,0"/>
                    <Border Background="{StaticResource Line}" Height="1" Margin="0,12"/>
                    <CheckBox x:Name="PrefetchCheck" Content="Prefetch" IsChecked="True" Click="Selection_Changed"/>
                    <TextBlock Text="Cache .pf recriado pelo Windows. Pode pedir autorização de administrador." Style="{StaticResource BodyCopy}" Margin="18,2,0,0"/>
                    <TextBlock x:Name="PrefetchLabel" Text="Aguardando análise" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="18,4,0,0"/>
                    <Border Background="{StaticResource Line}" Height="1" Margin="0,12"/>
                    <CheckBox x:Name="BinCheck" Content="Esvaziar lixeira · opcional" IsChecked="False" Click="Selection_Changed"/>
                    <TextBlock Text="Apaga permanentemente o conteúdo da sua lixeira em todas as unidades." Style="{StaticResource BodyCopy}" Margin="18,2,0,0"/>
                    <TextBlock x:Name="BinLabel" Text="Não selecionada" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="18,4,0,0"/>
                </StackPanel>
            </Border>
            <UniformGrid Columns="2" Margin="0,13,0,0">
                <Button x:Name="AnalyzeButton" Content="Analisar selecionados" Click="Analyze_Click" Style="{StaticResource Primary}" Margin="0,0,6,0"/>
                <Button x:Name="CleanButton" Content="Limpar selecionados…" Click="Clean_Click" Margin="6,0,0,0" IsEnabled="False"/>
            </UniformGrid>
            <TextBlock x:Name="ResultLabel" Style="{StaticResource BodyCopy}" Margin="0,13,0,0" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
