<UserControl x:Class="Soneca.CleanupView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="CategoryCard" TargetType="Border" BasedOn="{StaticResource Panel}">
            <Setter Property="Background" Value="#F3141F28"/>
            <Setter Property="BorderBrush" Value="#69416270"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="15,12"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="#F31B383D"/>
                    <Setter Property="BorderBrush" Value="#B6577E89"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CategoryIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Foreground" Value="#A4C9EB"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CategoryCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Background="Transparent" FocusVisualStyle="{x:Null}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                <Border x:Name="CheckSurface" Grid.Column="1" HorizontalAlignment="Right"
                                        Width="21" Height="21" BorderThickness="1" BorderBrush="#7792ACC3"
                                        CornerRadius="6" Background="{StaticResource Field}">
                                    <Path x:Name="CheckMark" Data="M2,6 L6,10 13,3" Stretch="None" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Stroke="{StaticResource AccentInk}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Visibility="Collapsed"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckSurface" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="CheckSurface" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckSurface" Property="BorderBrush" Value="{StaticResource Focus}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CheckSurface" Property="BorderBrush" Value="{StaticResource Focus}"/>
                                <Setter TargetName="CheckSurface" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CheckSurface" Property="Opacity" Value=".58"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CategoryStatus" TargetType="TextBlock" BasedOn="{StaticResource BodyCopy}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#B0C9E3"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="30,26,30,12" MaxWidth="990">
                <TextBlock Text="Limpeza" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Analise o espaço recuperável e confira os arquivos antes de remover." Style="{StaticResource BodyCopy}" Margin="0,5,0,17"/>
                <Border Style="{StaticResource Panel}" Background="{StaticResource GlassHero}" Padding="18,15">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width=".75*"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="Prévia da limpeza" Style="{StaticResource Overline}" FontSize="12"/>
                                <TextBlock x:Name="SummaryLabel" Text="Pronto para analisar" FontSize="20" FontWeight="SemiBold"
                                           TextWrapping="Wrap" Margin="0,5,0,0" AutomationProperties.LiveSetting="Polite"/>
                                <TextBlock x:Name="SummaryDetail" Style="{StaticResource BodyCopy}" FontSize="13" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TotalCaption" Text="Espaço recuperável" Style="{StaticResource BodyCopy}"
                                           FontSize="12" TextAlignment="Right"/>
                                <TextBlock x:Name="TotalLabel" Text="—" Foreground="#E0EFFF" FontSize="31" FontWeight="SemiBold"
                                           TextAlignment="Right" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                        <ProgressBar x:Name="ScanProgress" IsIndeterminate="False" Height="4" Margin="0,10,0,0"
                                     Visibility="Collapsed" Foreground="{StaticResource Accent}"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="O que analisar" Style="{StaticResource SectionTitle}" Margin="0,17,0,8"/>
                <UniformGrid Columns="2">
                    <Border Style="{StaticResource CategoryCard}" Margin="0,0,5,10" Tag="{Binding IsChecked, ElementName=TempCheck}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource CategoryIcon}" Text="&#xE8B7;"/>
                                <CheckBox x:Name="TempCheck" Style="{StaticResource CategoryCheck}" IsChecked="True" Click="Scope_Changed">
                                    <TextBlock Text="Temporários" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </CheckBox>
                            </DockPanel>
                            <TextBlock Text="Arquivos temporários do usuário." Style="{StaticResource BodyCopy}" FontSize="13" Margin="0,5,0,0"/>
                            <ComboBox x:Name="TempAge" SelectedIndex="0" MinWidth="134" HorizontalAlignment="Left" MinHeight="29"
                                      Margin="0,7,0,0" SelectionChanged="Scope_Changed"
                                      AutomationProperties.Name="Idade dos arquivos temporários">
                                <ComboBoxItem Tag="1">Mais de 1 dia</ComboBoxItem>
                                <ComboBoxItem Tag="7">Mais de 7 dias</ComboBoxItem>
                                <ComboBoxItem Tag="30">Mais de 30 dias</ComboBoxItem>
                                <ComboBoxItem Tag="0">Qualquer idade</ComboBoxItem>
                            </ComboBox>
                            <TextBlock x:Name="TempLabel" Text="Aguardando análise" Style="{StaticResource CategoryStatus}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CategoryCard}" Margin="5,0,0,10" Tag="{Binding IsChecked, ElementName=DumpsCheck}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource CategoryIcon}" Text="&#xE9D9;"/>
                                <CheckBox x:Name="DumpsCheck" Style="{StaticResource CategoryCheck}" Click="Scope_Changed">
                                    <TextBlock Text="Dumps de falha" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </CheckBox>
                            </DockPanel>
                            <TextBlock Text="Arquivos de diagnóstico gerados quando aplicativos falham." Style="{StaticResource BodyCopy}" FontSize="13" Margin="0,5,0,0"/>
                            <TextBlock x:Name="DumpsLabel" Text="Não selecionado" Style="{StaticResource CategoryStatus}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CategoryCard}" Margin="0,0,5,0" Tag="{Binding IsChecked, ElementName=PrefetchCheck}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource CategoryIcon}" Text="&#xE770;"/>
                                <CheckBox x:Name="PrefetchCheck" Style="{StaticResource CategoryCheck}" Click="Scope_Changed">
                                    <TextBlock Text="Cache do Windows" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </CheckBox>
                            </DockPanel>
                            <TextBlock Text="Arquivos do Prefetch. O Windows pode pedir autorização." Style="{StaticResource BodyCopy}" FontSize="13" Margin="0,5,0,0"/>
                            <TextBlock x:Name="PrefetchLabel" Text="Não selecionado" Style="{StaticResource CategoryStatus}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CategoryCard}" Margin="5,0,0,0" Tag="{Binding IsChecked, ElementName=BinCheck}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource CategoryIcon}" Text="&#xE74D;"/>
                                <CheckBox x:Name="BinCheck" Style="{StaticResource CategoryCheck}" Click="Scope_Changed">
                                    <TextBlock Text="Lixeira" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </CheckBox>
                            </DockPanel>
                            <TextBlock Text="Remove permanentemente o conteúdo da Lixeira de todas as unidades." Style="{StaticResource BodyCopy}" FontSize="13" Margin="0,5,0,0"/>
                            <TextBlock x:Name="BinLabel" Text="Não selecionado" Style="{StaticResource CategoryStatus}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <TextBlock x:Name="ResultLabel" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource BodyCopy}">
                            <Style.Triggers>
                                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Expander x:Name="Preview" Header="Ver até 15 maiores arquivos da prévia"
                          Foreground="{StaticResource Ink}" Visibility="Collapsed" Margin="0,12,0,0">
                    <Border Style="{StaticResource Panel}" Margin="0,7,0,0" Padding="11,6">
                        <ItemsControl x:Name="PreviewList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,5,0,6">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Size}" Style="{StaticResource InfoValue}" Margin="10,0,0,0"/>
                                        <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Style="{StaticResource Panel}" Background="#F3111C25" Padding="14,9" CornerRadius="13"
                MaxWidth="990" Margin="30,3,30,12">
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Interromper" Click="Cancel_Click" Visibility="Collapsed" Margin="0,0,8,0"/>
                <Button x:Name="AnalyzeButton" Content="Analisar" Click="Analyze_Click" Margin="0,0,8,0" MinWidth="93">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Primary}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEnabled, ElementName=CleanButton}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Field}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="CleanButton" Content="Revisar e limpar…" Click="Clean_Click" IsEnabled="False">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Primary}">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="{StaticResource Field}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </WrapPanel>
        </Border>
    </Grid>
</UserControl>
