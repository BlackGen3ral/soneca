<UserControl x:Class="Soneca.CleanupView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F4F2FB"/><Setter Property="FontSize" Value="16"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/></Style></UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="32,30" MaxWidth="690">
  <TextBlock Text="Limpeza do Windows" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Mais espaço, com você no controle." Foreground="#AAA7BC" FontSize="14" Margin="0,8,0,24"/>
  <Border Background="#1E1E29" CornerRadius="22" Padding="24"><StackPanel><TextBlock Text="ESPAÇO ENCONTRADO" Foreground="#BDB0EB" FontSize="11"/><TextBlock x:Name="TotalLabel" Text="—" FontSize="44" FontWeight="Light" Margin="0,8,0,4"/><TextBlock x:Name="SummaryLabel" Text="Selecione as categorias e analise antes de limpar." Foreground="#AAA7BC" TextWrapping="Wrap"/></StackPanel></Border>
  <Border Background="#1E1E29" CornerRadius="16" Padding="20" Margin="0,20,0,10"><StackPanel><CheckBox x:Name="TempCheck" Content="Arquivos temporários · %temp%" IsChecked="True" Click="Selection_Changed"/><TextBlock Text="Arquivos temporários do seu usuário. Itens em uso são ignorados." Foreground="#9997AA" TextWrapping="Wrap" Margin="20,7,0,0"/><TextBlock x:Name="TempLabel" Text="Aguardando análise" Foreground="#C7B8FF" Margin="20,9,0,0" TextWrapping="Wrap"/></StackPanel></Border>
  <Border Background="#1E1E29" CornerRadius="16" Padding="20" Margin="0,0,0,10"><StackPanel><CheckBox x:Name="PrefetchCheck" Content="Prefetch" IsChecked="True" Click="Selection_Changed"/><TextBlock Text="Cache .pf recriado pelo Windows. A limpeza não garante mais velocidade e pode pedir autorização de administrador." Foreground="#9997AA" TextWrapping="Wrap" Margin="20,7,0,0"/><TextBlock x:Name="PrefetchLabel" Text="Aguardando análise" Foreground="#C7B8FF" Margin="20,9,0,0" TextWrapping="Wrap"/></StackPanel></Border>
  <Border Background="#1E1E29" CornerRadius="16" Padding="20" Margin="0,0,0,16"><StackPanel><CheckBox x:Name="BinCheck" Content="Esvaziar lixeira · opcional" IsChecked="False" Click="Selection_Changed"/><TextBlock Text="Apaga permanentemente o conteúdo da sua lixeira em todas as unidades." Foreground="#9997AA" TextWrapping="Wrap" Margin="20,7,0,0"/><TextBlock x:Name="BinLabel" Text="Não selecionada" Foreground="#C7B8FF" Margin="20,9,0,0" TextWrapping="Wrap"/></StackPanel></Border>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="AnalyzeButton" Content="Analisar selecionados" Click="Analyze_Click" Margin="0,0,6,0"/><Button x:Name="CleanButton" Content="Limpar selecionados…" Click="Clean_Click" Grid.Column="1" Margin="6,0,0,0" Background="#C7B8FF" Foreground="#211C34" IsEnabled="False"/></Grid>
  <TextBlock x:Name="ResultLabel" Foreground="#C9C5DA" Margin="0,16,0,0" TextWrapping="Wrap" LineHeight="21"/>
 </StackPanel></ScrollViewer>
</UserControl>
