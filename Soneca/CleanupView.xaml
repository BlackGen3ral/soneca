<UserControl x:Class="Soneca.CleanupView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,25,30,25" MaxWidth="960">
            <TextBlock Text="Limpeza" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Confira a prévia antes de remover arquivos." Style="{StaticResource BodyCopy}" Margin="0,5,0,15"/>

            <Border Style="{StaticResource Panel}" Padding="14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0">
                        <TextBlock x:Name="TotalCaption" Text="Volume estimado" Style="{StaticResource BodyCopy}" TextAlignment="Right"/>
                        <TextBlock x:Name="TotalLabel" Text="—" FontSize="24" FontWeight="SemiBold" TextAlignment="Right"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="SummaryLabel" Text="Selecione o que deseja analisar." Style="{StaticResource InfoValue}"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock x:Name="SummaryDetail" Style="{StaticResource BodyCopy}" Margin="0,3,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Text="Categorias" Style="{StaticResource SectionTitle}" Margin="0,17,0,7"/>
            <Border Style="{StaticResource Panel}" Padding="14,1">
                <StackPanel>
                    <StackPanel Margin="0,9">
                        <DockPanel>
                            <ComboBox x:Name="TempAge" DockPanel.Dock="Right" SelectedIndex="0" MinWidth="146" Margin="10,0,0,0"
                                      SelectionChanged="Scope_Changed" AutomationProperties.Name="Idade dos arquivos temporários">
                                <ComboBoxItem Tag="1"><TextBlock Text="Mais de 1 dia"/></ComboBoxItem>
                                <ComboBoxItem Tag="7"><TextBlock Text="Mais de 7 dias"/></ComboBoxItem>
                                <ComboBoxItem Tag="30"><TextBlock Text="Mais de 30 dias"/></ComboBoxItem>
                                <ComboBoxItem Tag="0"><TextBlock Text="Qualquer idade"/></ComboBoxItem>
                            </ComboBox>
                            <CheckBox x:Name="TempCheck" Content="Arquivos temporários do usuário" IsChecked="True" Click="Scope_Changed"/>
                        </DockPanel>
                        <TextBlock x:Name="TempLabel" Text="Aguardando análise" Style="{StaticResource BodyCopy}" Margin="19,2,0,0"/>
                    </StackPanel>
                    <Border Style="{StaticResource Divider}"/>
                    <StackPanel Margin="0,9">
                        <CheckBox x:Name="DumpsCheck" Content="Dumps de falha de aplicativos" Click="Scope_Changed"/>
                        <TextBlock Text="Arquivos .dmp da sua pasta CrashDumps. Úteis se você estiver investigando um erro."
                                   Style="{StaticResource BodyCopy}" Margin="19,1,0,0"/>
                        <TextBlock x:Name="DumpsLabel" Text="Não selecionado" Style="{StaticResource BodyCopy}" Margin="19,3,0,0"/>
                    </StackPanel>
                    <Border Style="{StaticResource Divider}"/>
                    <StackPanel Margin="0,9">
                        <CheckBox x:Name="PrefetchCheck" Content="Cache do Windows (Prefetch)" Click="Scope_Changed"/>
                        <TextBlock Text="Arquivos .pf da pasta Prefetch. O Windows pode pedir autorização."
                                   Style="{StaticResource BodyCopy}" Margin="19,1,0,0"/>
                        <TextBlock x:Name="PrefetchLabel" Text="Não selecionado" Style="{StaticResource BodyCopy}" Margin="19,3,0,0"/>
                    </StackPanel>
                    <Border Style="{StaticResource Divider}"/>
                    <StackPanel Margin="0,9">
                        <CheckBox x:Name="BinCheck" Content="Esvaziar a Lixeira" Click="Scope_Changed"/>
                        <TextBlock Text="Remove permanentemente todo o conteúdo da Lixeira em todas as unidades."
                                   Style="{StaticResource BodyCopy}" Margin="19,1,0,0"/>
                        <TextBlock x:Name="BinLabel" Text="Não selecionado" Style="{StaticResource BodyCopy}" Margin="19,3,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <WrapPanel Margin="0,12,0,0">
                <Button x:Name="AnalyzeButton" Content="Analisar" Click="Analyze_Click" Style="{StaticResource Primary}" Margin="0,0,8,6"/>
                <Button x:Name="CleanButton" Content="Limpar…" Click="Clean_Click" IsEnabled="False" Margin="0,0,8,6"/>
                <Button x:Name="CancelButton" Content="Interromper" Click="Cancel_Click" Visibility="Collapsed" Margin="0,0,8,6"/>
            </WrapPanel>
            <TextBlock x:Name="ResultLabel" Style="{StaticResource BodyCopy}" Margin="0,5,0,0" AutomationProperties.LiveSetting="Polite"/>
            <Expander x:Name="Preview" Header="Ver até 15 maiores arquivos da prévia" Foreground="{StaticResource Muted}"
                      Visibility="Collapsed" Margin="0,9,0,0">
                <ItemsControl x:Name="PreviewList" Margin="8,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,1,0,6">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Size}" Style="{StaticResource InfoValue}" Margin="10,0,0,0"/>
                                <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
