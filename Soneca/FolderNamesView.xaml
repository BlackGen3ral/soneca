<UserControl x:Class="Soneca.FolderNamesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="Margin" Value="0,0,20,8"/></Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="MinWidth" Value="205"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,0,12,10"/></Style></UserControl.Resources>
 <Grid Margin="30,25,30,25" MaxWidth="1080"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel><TextBlock Text="Nomes da pasta" Style="{StaticResource PageTitle}"/><TextBlock Text="Liste arquivos e pastas para copiar ou salvar como texto." Style="{StaticResource BodyCopy}" Margin="0,5,0,18"/></StackPanel>
 <Border Grid.Row="1" Grid.RowSpan="3" Style="{StaticResource Panel}" Margin="0,0,0,10"/>
 <Grid Grid.Row="1" Margin="16,16,16,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="FolderInput" FontSize="13" Margin="0,0,10,0" AutomationProperties.Name="Caminho da pasta"/><Button Grid.Column="1" Content="Escolher pasta…" Click="Choose_Click" Style="{StaticResource Primary}"/></Grid>
 <StackPanel Grid.Row="2" Margin="16,12,16,4"><WrapPanel><ComboBox x:Name="KindBox" SelectedIndex="0" SelectionChanged="Options_Changed" AutomationProperties.Name="Tipos de itens"><ComboBoxItem><TextBlock Text="Arquivos e pastas"/></ComboBoxItem><ComboBoxItem><TextBlock Text="Somente arquivos"/></ComboBoxItem><ComboBoxItem><TextBlock Text="Somente pastas"/></ComboBoxItem></ComboBox><ComboBox x:Name="OrderBox" SelectedIndex="0" SelectionChanged="Options_Changed" AutomationProperties.Name="Ordenação"><ComboBoxItem><TextBlock Text="Nome · A–Z"/></ComboBoxItem><ComboBoxItem><TextBlock Text="Modificados recentemente"/></ComboBoxItem></ComboBox></WrapPanel><WrapPanel><CheckBox x:Name="ExtensionsCheck" Content="Mostrar extensões" IsChecked="True" Click="Options_Changed"/><CheckBox x:Name="NumberedCheck" Content="Numerar lista" Click="Options_Changed"/><CheckBox x:Name="RecursiveCheck" Content="Incluir subpastas" Click="Recursive_Changed"/></WrapPanel></StackPanel>
 <Grid Grid.Row="3" Margin="16,0,16,24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusLabel" Text="Escolha uma pasta ou cole o caminho e clique em Ler pasta." Foreground="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/><Button x:Name="ReadButton" Grid.Column="1" Content="Ler pasta" Click="Read_Click"/></Grid>
 <TextBox Grid.Row="4" x:Name="Preview" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13" VerticalContentAlignment="Top" AutomationProperties.Name="Prévia da lista"/>
 <Grid Grid.Row="5" Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="SaveButton" Content="Salvar .txt…" Click="Save_Click" Margin="0,0,6,0" IsEnabled="False"/><Button x:Name="CopyButton" Grid.Column="1" Content="Copiar todos os nomes" Click="Copy_Click" Margin="6,0,0,0" Style="{StaticResource Primary}" IsEnabled="False"/></Grid>
 </Grid>
</UserControl>
