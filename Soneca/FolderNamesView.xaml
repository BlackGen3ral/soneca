<UserControl x:Class="Soneca.FolderNamesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F4F2FB"/><Setter Property="Margin" Value="0,0,20,10"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style><Style TargetType="ComboBox"><Style.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#211C34"/></Style></Style.Resources><Setter Property="Foreground" Value="#211C34"/><Setter Property="MinWidth" Value="205"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,0,12,12"/></Style></UserControl.Resources>
 <Grid Margin="32,30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel><TextBlock Text="Nomes da pasta" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Todos os nomes completos, prontos para copiar." Foreground="#AAA7BC" Margin="0,8,0,24"/></StackPanel>
 <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="FolderInput" FontSize="13" Margin="0,0,10,0" AutomationProperties.Name="Caminho da pasta"/><Button Grid.Column="1" Content="Escolher pasta…" Click="Choose_Click"/></Grid>
 <StackPanel Grid.Row="2" Margin="0,20,0,4"><WrapPanel><ComboBox x:Name="KindBox" SelectedIndex="0" SelectionChanged="Options_Changed" AutomationProperties.Name="Tipos de itens"><ComboBoxItem><TextBlock Text="Arquivos e pastas" Foreground="#211C34"/></ComboBoxItem><ComboBoxItem><TextBlock Text="Somente arquivos" Foreground="#211C34"/></ComboBoxItem><ComboBoxItem><TextBlock Text="Somente pastas" Foreground="#211C34"/></ComboBoxItem></ComboBox><ComboBox x:Name="OrderBox" SelectedIndex="0" SelectionChanged="Options_Changed" AutomationProperties.Name="Ordenação"><ComboBoxItem><TextBlock Text="Nome · A–Z" Foreground="#211C34"/></ComboBoxItem><ComboBoxItem><TextBlock Text="Modificados recentemente" Foreground="#211C34"/></ComboBoxItem></ComboBox></WrapPanel><WrapPanel><CheckBox x:Name="ExtensionsCheck" Content="Mostrar extensões" IsChecked="True" Click="Options_Changed"/><CheckBox x:Name="NumberedCheck" Content="Numerar lista" Click="Options_Changed"/><CheckBox x:Name="RecursiveCheck" Content="Incluir subpastas" Click="Recursive_Changed"/></WrapPanel></StackPanel>
 <Grid Grid.Row="3" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusLabel" Text="Escolha uma pasta ou cole o caminho e clique em Ler pasta." Foreground="#AAA7BC" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/><Button x:Name="ReadButton" Grid.Column="1" Content="Ler pasta" Click="Read_Click"/></Grid>
 <TextBox Grid.Row="4" x:Name="Preview" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13" AutomationProperties.Name="Prévia da lista"/>
 <Grid Grid.Row="5" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="SaveButton" Content="Salvar .txt…" Click="Save_Click" Margin="0,0,6,0" IsEnabled="False"/><Button x:Name="CopyButton" Grid.Column="1" Content="Copiar todos os nomes" Click="Copy_Click" Margin="6,0,0,0" Background="#C7B8FF" Foreground="#211C34" IsEnabled="False"/></Grid>
 </Grid>
</UserControl>
